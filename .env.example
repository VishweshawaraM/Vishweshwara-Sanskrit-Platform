# Copy to .env.local and fill in. Never commit .env.local.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Database (Supabase Postgres) -------------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string (URI).
# Use the SESSION POOLER string for serverless.
DATABASE_URL=

# ---- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Zoom Server-to-Server OAuth (Phase 2) -----------------------------------
# Zoom App Marketplace → Develop → Build App → Server-to-Server OAuth.
# Scopes: meeting:write:admin meeting:read:admin recording:write:admin
#         recording:read:admin report:read:admin user:read:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# ---- Cloudflare R2 (recording offload, Phase 2) ------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- Email (Phase 2) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
